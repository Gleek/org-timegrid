;;; org-timegrid-scroll-test.el --- Automatic scrolling -*- lexical-binding: t; -*-

(require 'ert)
(require 'org-timegrid-test-support
         (expand-file-name "org-timegrid-test-support.el"
                           (file-name-directory load-file-name)))

(defun org-timegrid-scroll-test--move (minutes &optional offset body)
  "Move the calendar cursor through MINUTES and return viewport offsets.
Use 15-pixel slots, starting at OFFSET (default 300), in a BODY-pixel
viewport (default 300).  Exercise cursor reveal including boundary clamps."
  (with-temp-buffer
    (let* ((org-timegrid-start-hour 0)
           (org-timegrid-slot-minutes 15)
           (org-timegrid--image-height 1440)
           (cursor (org-timegrid--cursor-state-create :surface 'grid :minute 450))
           (org-timegrid--state (org-timegrid--calendar-state-create :cursor cursor))
           (offset (or offset 300)))
      (cl-letf (((symbol-function 'get-buffer-window) (lambda (&rest _) (selected-window)))
                ((symbol-function 'window-body-height) (lambda (&rest _) (or body 300)))
                ((symbol-function 'org-timegrid--grid-top-inset) (lambda () 0))
                ((symbol-function 'org-timegrid--pixels-per-minute) (lambda () 1))
                ((symbol-function 'org-timegrid--window-scroll-pixels) (lambda (_) offset))
                ((symbol-function 'org-timegrid--set-vscroll)
                 (lambda (_window pixels) (setq offset (round pixels)))))
        (mapcar (lambda (minute)
                  (setf (org-timegrid--cursor-state-minute cursor) minute)
                  (org-timegrid--scroll-cursor-into-view)
                  offset)
                minutes)))))

(ert-deftest org-timegrid-scroll-conservative-distance-and-jumps ()
  (let ((scroll-margin 0) (maximum-scroll-margin 0.25)
        (scroll-step 0) scroll-up-aggressively scroll-down-aggressively)
    (let ((scroll-conservatively 1))
      (should (equal (org-timegrid-scroll-test--move '(585 600 615 900))
                     '(300 315 330 758)))
      (should (equal (org-timegrid-scroll-test--move '(300 285 270 60))
                     '(300 285 270 0))))
    (let ((scroll-conservatively 0))
      (should (equal (org-timegrid-scroll-test--move '(585 600)) '(300 458))))
    ;; Values above 100 never recenter, including jumps beyond 101 slots.
    (let ((scroll-conservatively 101))
      (should (equal (org-timegrid-scroll-test--move '(900 60)) '(615 60)))
      (should (= (org-timegrid--cursor-scroll-target 6000 15 300 300) 5715)))
    (let ((scroll-conservatively 99))
      (should (= (org-timegrid--cursor-scroll-target 6000 15 300 300) 5857.5)))))

(ert-deftest org-timegrid-scroll-step-and-policy-precedence ()
  (let ((scroll-margin 0) (maximum-scroll-margin 0.25)
        (scroll-conservatively 0) (scroll-step 3)
        scroll-up-aggressively scroll-down-aggressively)
    (should (equal (org-timegrid-scroll-test--move '(600 615 630 645 900))
                   '(345 345 345 390 758)))
    (should (equal (org-timegrid-scroll-test--move '(285 270 255 240 60))
                   '(255 255 255 210 0)))
    (let ((scroll-up-aggressively 0.25))
      (should (equal (org-timegrid-scroll-test--move '(600 900)) '(345 690))))
    (let ((scroll-conservatively 1) (scroll-up-aggressively 0.25))
      (should (equal (org-timegrid-scroll-test--move '(600 900)) '(315 758))))))

(ert-deftest org-timegrid-scroll-margins-and-emacs-cap ()
  (let ((scroll-margin 2) (maximum-scroll-margin 0.25)
        (scroll-conservatively 101) (scroll-step 0)
        scroll-up-aggressively scroll-down-aggressively)
    (should (equal (org-timegrid-scroll-test--move '(555 570 585 600))
                   '(300 315 330 345)))
    (should (equal (org-timegrid-scroll-test--move '(330 315 300 285))
                   '(300 285 270 255)))
    (let ((scroll-margin 10))
      (should (equal (org-timegrid-scroll-test--move '(450 600)) '(300 390)))
      (dolist (ratio '(nil 1 0.25 1.0 -0.1 0.0 0.5))
        (let ((maximum-scroll-margin ratio))
          (should (= (car (org-timegrid-scroll-test--move '(600)))
                     (cond ((equal ratio 1.0) 450)
                           ((member ratio '(-0.1 0.0)) 315)
                           ((equal ratio 0.5) 450)
                           (t 390)))))))
    ;; Half-height margins leave at least one complete cursor slot.
    (let ((scroll-margin 100) (maximum-scroll-margin 0.5))
      (should (equal (org-timegrid-scroll-test--move '(450 465 480))
                     '(300 315 330))))))

(ert-deftest org-timegrid-scroll-aggressive-directions-and-bounds ()
  (let ((scroll-margin 0) (maximum-scroll-margin 0.25)
        (scroll-conservatively 0) (scroll-step 0)
        (scroll-up-aggressively 0.25) (scroll-down-aggressively 0.1))
    (should (equal (org-timegrid-scroll-test--move '(600 615 900)) '(390 390 690)))
    (should (equal (org-timegrid-scroll-test--move '(285 270 60)) '(255 255 30)))
    (let ((scroll-margin 2))
      (should (equal (org-timegrid-scroll-test--move '(570)) '(390)))
      (should (equal (org-timegrid-scroll-test--move '(315)) '(255))))
    (let ((scroll-up-aggressively 1.0) (scroll-down-aggressively 1.0))
      (should (equal (org-timegrid-scroll-test--move '(600 285)) '(600 0))))
    (should (equal (org-timegrid-scroll-test--move '(0 1425)) '(0 1140)))))

(ert-deftest org-timegrid-scroll-policy-scales-with-calendar-slots ()
  (let ((scroll-margin 2) (maximum-scroll-margin 0.25)
        (scroll-conservatively 1) (scroll-step 0)
        scroll-up-aggressively scroll-down-aggressively)
    (dolist (scale '(0.5 1.0 2.0))
      (should (= (org-timegrid--cursor-scroll-target
                  (* 570 scale) (* 15 scale) (* 300 scale) (* 300 scale))
                 (* 315 scale)))
      (should (= (org-timegrid--cursor-scroll-target
                  (* 900 scale) (* 15 scale) (* 300 scale) (* 300 scale))
                 (* 757.5 scale))))))

(provide 'org-timegrid-scroll-test)
;;; org-timegrid-scroll-test.el ends here
