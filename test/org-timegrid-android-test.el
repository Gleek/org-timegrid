;;; org-timegrid-android-test.el --- Android touch tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'org-timegrid-android)

(defvar android-keyboard-bell-duration 50)
(defvar touch-screen-current-tool nil)
(defvar touch-screen-current-timer nil)

(ert-deftest org-timegrid-android-resize-touch-zones-leave-room-to-move ()
  (with-temp-buffer
    (org-timegrid-android--configure-buffer)
    (let ((bounds '(:y 100 :height 64 :allow-top t :allow-bottom t)))
      (dolist (y '(90 100 124))
        (should (eq (org-timegrid--edge-at bounds y) 'top)))
      (dolist (y '(140 164 174))
        (should (eq (org-timegrid--edge-at bounds y) 'bottom)))
      (should-not (org-timegrid--edge-at bounds 132)))))

(ert-deftest org-timegrid-android-haptic-uses-a-temporary-native-bell ()
  (let ((window-system 'android)
        (org-timegrid-android-haptic-duration 30)
        (android-keyboard-bell-duration 100)
        (ring-bell-function #'ignore)
        (visible-bell t)
        calls)
    (cl-letf (((symbol-function 'ding)
               (lambda (arg)
                 (push (list arg android-keyboard-bell-duration
                             ring-bell-function visible-bell) calls))))
      (org-timegrid-android--haptic-feedback)
      (let ((org-timegrid-android-haptic-duration nil))
        (org-timegrid-android--haptic-feedback))
      (let ((window-system 'ns))
        (org-timegrid-android--haptic-feedback)))
    (should (equal calls '((t 30 nil nil))))
    (should (= android-keyboard-bell-duration 100))
    (should (eq ring-bell-function #'ignore))
    (should visible-bell)))

(ert-deftest org-timegrid-android-long-press-signals-before-tracking ()
  (dolist (origin '(nil
                    (:surface grid :day 0 :minute 600)
                    (:surface grid :day 0 :minute 600 :block-id event)
                    (:surface grid :day 0 :minute 600 :block-id event :edge top)
                    (:surface grid :day 0 :minute 600 :block-id event :edge bottom)
                    (:surface rail :day 0)))
    (dolist (result '(t no-drag))
      (let ((org-timegrid--state (org-timegrid--calendar-state-create))
            (touch-screen-current-tool '(1 nil nil nil start))
            (touch-screen-current-timer 'timer)
            calls)
        (cl-letf (((symbol-function 'org-timegrid--reconcile) #'ignore)
              ((symbol-function 'posn-window) (lambda (_) (selected-window)))
                  ((symbol-function 'org-timegrid--mouse-target) (lambda (_) origin))
                  ((symbol-function 'org-timegrid--block) #'ignore)
                  ((symbol-function 'org-timegrid--all-day-layout) #'ignore)
                  ((symbol-function 'org-timegrid-android--haptic-feedback)
                   (lambda () (push 'haptic calls)))
                  ((symbol-function 'touch-screen-track-drag)
                   (lambda (&rest _) (push 'track calls) result))
                  ((symbol-function 'org-timegrid-android--proposal) #'ignore)
                  ((symbol-function 'org-timegrid--set-preview)
                   (lambda (_) (push 'preview calls)))
                  ((symbol-function 'redisplay)
                   (lambda (&rest _) (push 'display calls)))
                  ((symbol-function 'org-timegrid--apply)
                   (lambda (_) (push 'apply calls)))
                  ((symbol-function 'org-timegrid-context-menu)
                   (lambda (_) (push 'menu calls)))
                  ((symbol-function 'org-timegrid--clear-preview) #'ignore))
          (org-timegrid-android-long-press '(touchscreen-hold position)))
        (should (equal (reverse calls)
                       (when origin
                         (append (when (plist-get origin :edge) '(preview display))
                                 (list 'haptic 'track (if (eq result t) 'apply 'menu))))))))))

(ert-deftest org-timegrid-android-resize-handle-follows-the-armed-edge ()
  (let* ((org-timegrid-default-zoom 5.1)
         (block (org-timegrid--make-block 'event 0 600 660 "Event" 'green))
         (org-timegrid--state
          (org-timegrid--calendar-state-create :week-start 100 :blocks (list block)))
         (org-timegrid--image-height 6000)
         (origin '(:surface grid :day 0 :minute 600 :block-id event)))
    (dolist (edge '(top bottom))
      (let* ((from (append origin (list :edge edge))))
        (dolist (minute '(600 630))
          (let* ((proposal (org-timegrid-android--proposal
                            from (plist-put (copy-sequence origin) :minute minute)))
                 (scene (org-timegrid--build-scene proposal))
                 (bounds (car (org-timegrid--scene-geometry scene)))
                 (handle (cdr (assq 'resize-handle (org-timegrid--scene-nodes scene)))))
            (should handle)
            (should (= (+ (plist-get handle :y) (/ (plist-get handle :height) 2.0))
                       (+ (plist-get bounds :y)
                          (if (eq edge 'top) 0 (plist-get bounds :height)))))
            (should (equal (org-timegrid--accent (plist-get handle :block)
                                                (org-timegrid--palette))
                           (org-timegrid--accent block (org-timegrid--palette))))
            (should (= (+ (plist-get handle :x) (/ (plist-get handle :width) 2.0))
                       (+ (plist-get bounds :x) (/ (plist-get bounds :width) 2.0))))))))
    (should-not (assq 'resize-handle
                      (org-timegrid--scene-nodes (org-timegrid--build-scene))))))

(ert-deftest org-timegrid-android-clock-resize-grip-is-round ()
  (let* ((org-timegrid-default-zoom 5.1)
         (block (org-timegrid--make-block 'clock 0 600 660 "Clock"))
         (org-timegrid--state
          (org-timegrid--calendar-state-create :week-start 100 :blocks (list block)))
         (origin '(:surface grid :day 0 :minute 600 :block-id clock)))
    (setf (org-timegrid-block-event block)
          (org-timegrid-event-create :id 'clock :metadata '(:clock t)))
    (dolist (edge '(top bottom))
      (let* ((from (append origin (list :edge edge)))
             (scene (org-timegrid--build-scene (org-timegrid-android--proposal from from)))
             (handle (assq 'resize-handle (org-timegrid--scene-nodes scene)))
             (bounds (cdr handle))
             (block-bounds (car (org-timegrid--scene-geometry scene)))
             (palette (org-timegrid--palette))
             (svg (svg-create 900 6000)))
        (should (plist-get bounds :clock))
        (should (= (plist-get bounds :width) (plist-get bounds :height)))
        (should (= (+ (plist-get bounds :y) (/ (plist-get bounds :height) 2.0))
                   (+ (plist-get block-bounds :y)
                      (if (eq edge 'top) 0 (plist-get block-bounds :height)))))
        (org-timegrid--paint-node svg handle palette "default")
        (let ((grip (car (dom-by-tag svg 'rect))))
          (should (= (dom-attr grip 'rx) (/ (dom-attr grip 'width) 2.0)))
          (should (equal (dom-attr grip 'fill) (plist-get palette :clock))))))))

(ert-deftest org-timegrid-android-armed-resize-prefetches-the-correct-edge ()
  "An unmoved top grip must prepare top-edge positions immediately."
  (with-temp-buffer
    (let* ((block (org-timegrid--make-block 'event 0 600 660 "Event"))
           (org-timegrid-days 1)
           (org-timegrid-preview-prefetch t)
           (org-timegrid--state
            (org-timegrid--calendar-state-create :week-start 100 :blocks (list block))))
      (dolist (edge '(top bottom))
        (setf (org-timegrid--calendar-state-preview org-timegrid--state)
              (org-timegrid--keyboard-proposal block 0 0 edge))
        (cl-letf (((symbol-function 'org-timegrid--ensure-preview-cache) #'ignore)
                  ((symbol-function 'org-timegrid--arm-preview-preparation) #'ignore))
          (org-timegrid--schedule-preview-preparation nil))
        (should org-timegrid--preview-candidates)
        (dolist (proposal org-timegrid--preview-candidates)
          (let ((candidate (org-timegrid--operation-block proposal)))
            (if (eq edge 'top)
                (should (= 660 (org-timegrid-block-end candidate)))
              (should (= 600 (org-timegrid-block-start candidate))))))))))

