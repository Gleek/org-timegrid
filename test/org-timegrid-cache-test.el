;;; org-timegrid-cache-test.el --- Cached navigation and tile regressions -*- lexical-binding: t; -*-

(require 'ert)
(require 'org-timegrid-org)

(ert-deftest org-timegrid-cache-redraws-do-not-retain-undo-history ()
  "Replacing the displayed image must not retain old SVGs in text undo."
  ;; Unlike temporary buffers whose names start with a space, a normal
  ;; calendar buffer starts with text undo enabled.
  (let ((buffer (generate-new-buffer "*Timegrid image retention test*")))
    (unwind-protect
        (with-current-buffer buffer
          (org-timegrid-mode)
          (setq org-timegrid--state (org-timegrid--calendar-state-create :week-start 100)
                org-timegrid--static-images (vector '(image :type svg :data "initial"))
                org-timegrid--tile-count 1 org-timegrid--tile-columns 1)
          (org-timegrid--insert-tiles)
          (cl-letf (((symbol-function 'image-flush) #'ignore))
            (dotimes (i 100)
              (org-timegrid--set-tile-image
               0 (list 'image :type 'svg :data (format "image %d" i)))))
          (should (eq buffer-undo-list t))
          (should (equal "image 99" (plist-get (cdr (get-text-property 1 'display)) :data)))
          (should (<= (length org-timegrid--transient-images) 32)))
      (kill-buffer buffer))))

(ert-deftest org-timegrid-cache-android-hour-labels ()
  "Keep outlined hour labels above the background and in gutter cells."
  (require 'org-timegrid-android)
  (with-temp-buffer
    (let ((org-timegrid--state (org-timegrid--calendar-state-create :week-start 739915)))
      (cl-letf (((symbol-function 'org-timegrid--draw-text) #'org-timegrid-android--draw-text)
                ((symbol-function 'create-image)
                 (lambda (data &rest _) (list 'image :type 'svg :data data))))
        (org-timegrid--build-static-tiles)
        (should-not (string-match-p "<path" org-timegrid--static-inner))
        (should (string-match-p "<path" (aref org-timegrid--static-fragments 0)))
        (should-not (string-match-p "<path" (aref org-timegrid--static-fragments 1)))))))

(ert-deftest org-timegrid-cache-close-flushes-images-without-cache-owners ()
  "Closing after cache eviction releases the visible grid and rail images."
  (let ((buffer (generate-new-buffer "*Timegrid cleanup test*"))
        (base '(image :type svg :data "base"))
        (overlay '(image :type svg :data "overlay"))
        (header '(image :type svg :data "header"))
        flushed)
    (unwind-protect
        (cl-letf (((symbol-function 'image-flush)
                   (lambda (image &rest _) (push image flushed))))
          (with-current-buffer buffer
            (org-timegrid-mode)
            (setq org-timegrid--state (org-timegrid--calendar-state-create :week-start 100)
                  org-timegrid--static-images (vector base)
                  org-timegrid--tile-count 1 org-timegrid--tile-columns 1)
            (org-timegrid--insert-tiles)
            (org-timegrid--set-tile-image 0 overlay)
            (setq org-timegrid--dynamic-tiles '(0)
                  header-line-format (propertize " " 'display header))
            (kill-buffer buffer))
          (dolist (image (list base overlay header))
            (should (memq image flushed))))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest org-timegrid-cache-replacement-flushes-redecoded-old-images ()
  "An old view redrawn during invalidation must be released on replacement."
  (with-temp-buffer
    (let ((old '(image :type svg :data "old"))
          (new '(image :type svg :data "new"))
          (decoded (make-hash-table :test #'eq)))
      (setq org-timegrid--static-images (vector old)
            org-timegrid--tile-count 1 org-timegrid--tile-columns 1)
      (org-timegrid--insert-tiles)
      (cl-letf (((symbol-function 'image-flush)
                 (lambda (image &rest _) (remhash image decoded))))
        (puthash old t decoded)
        (org-timegrid--clear-view-cache)
        ;; Redisplay can decode the still-visible old view before replacement.
        (puthash old t decoded)
        (setq org-timegrid--static-images (vector new))
        (org-timegrid--insert-tiles)
        (should-not (gethash old decoded))
        (should (eq new (get-text-property 1 'display)))
        (should-not org-timegrid--pending-image-flush)))))

(ert-deftest org-timegrid-cache-org-navigation-and-edits ()
  "Nearby queries reuse parsing, while edits and settings take effect."
  (with-temp-buffer
    (org-mode)
    (insert "* Plan\n<2026-10-26 Mon 10:00-11:00 +1d>\n"
            "* Logged\n:LOGBOOK:\nCLOCK: [2026-10-27 Tue 09:00]--[2026-10-27 Tue 10:00] => 1:00\n:END:\n")
    (let* ((start (* 1440 (calendar-absolute-from-gregorian '(10 26 2026))))
           (org-timegrid-org-show-clocks t)
           (parse (symbol-function 'org-timegrid-org--buffer-events))
           (calls 0))
      (cl-letf (((symbol-function 'org-timegrid-org--buffer-events)
                 (lambda (&rest args) (cl-incf calls) (apply parse args))))
        (should (= 1 (length (org-timegrid-org--cached-events "dummy.org" start (+ start 1440)))))
        (should (= 2 (length (org-timegrid-org--cached-events "dummy.org" (+ start 1440) (+ start 2880)))))
        (should (= calls 1))
        (goto-char (point-min)) (search-forward "Plan") (replace-match "Changed")
        (should (equal "Changed" (org-timegrid-event-title
                                   (car (org-timegrid-org--cached-events "dummy.org" start (+ start 1440))))))
        (should (= calls 2))
        (let ((org-timegrid-org-show-clocks nil))
          (should (= 1 (length (org-timegrid-org--cached-events "dummy.org" (+ start 1440) (+ start 2880))))))
        (should (= calls 3))
        (let ((org-timegrid-query-options '(:force t)))
          (org-timegrid-org--cached-events "dummy.org" start (+ start 1440)))
        (should (= calls 4))))))

(ert-deftest org-timegrid-cache-edit-refresh-only-reparses-changed-files ()
  "Creation and deletion invalidate their file; manual refresh reparses all."
  (with-temp-buffer
    (org-mode)
    (insert "* First\n<2026-10-26 Mon 10:00-11:00>\n")
    (let ((first (current-buffer)))
      (with-temp-buffer
        (org-mode)
        (insert "* Second\n<2026-10-26 Mon 12:00-13:00>\n")
        (let ((sources (list first (current-buffer)))
              (day (calendar-absolute-from-gregorian '(10 26 2026))))
          (with-temp-buffer
            (let* ((org-timegrid-days 1)
                   (org-timegrid--backend
                    (org-timegrid-backend-create
                     :list-function
                     (lambda (start end)
                       (mapcan (lambda (buffer)
                                 (with-current-buffer buffer
                                   (org-timegrid-org--cached-events (buffer-name) start end)))
                               sources))))
                   (org-timegrid--state (org-timegrid--load-state day))
                   (parse (symbol-function 'org-timegrid-org--buffer-events))
                   calls)
              (cl-letf (((symbol-function 'org-timegrid--refresh) #'ignore)
                        ((symbol-function 'org-timegrid-org--buffer-events)
                         (lambda (&rest args)
                           (push (current-buffer) calls)
                           (apply parse args))))
                (org-timegrid--refresh-data)
                (should-not calls)
                (with-current-buffer first
                  (goto-char (point-max))
                  (insert "* New\n<2026-10-26 Mon 14:00-15:00>\n"))
                (org-timegrid--refresh-data)
                (should (equal calls (list first)))
                (should (= 3 (length (org-timegrid--calendar-state-events org-timegrid--state))))
                (with-current-buffer first (erase-buffer))
                (org-timegrid--refresh-data)
                (should (equal calls (list first first)))
                (should (= 1 (length (org-timegrid--calendar-state-events org-timegrid--state))))
                (org-timegrid-refresh)
                (should (= 4 (length calls)))))))))))

(ert-deftest org-timegrid-cache-running-clock-advances ()
  "Running clock events expire when the minute advances, without an edit."
  (with-temp-buffer
    (org-mode)
    (let ((minute 100) (calls 0))
      (cl-letf (((symbol-function 'float-time) (lambda (&rest _) (* minute 60.0)))
                ((symbol-function 'org-timegrid-org--buffer-events)
                 (lambda (&rest _)
                   (cl-incf calls)
                   (list (org-timegrid-event-create
                          :id 'clock :title "Running" :start 0 :end minute
                          :metadata '(:clock t :running t))))))
        (should (= 100 (org-timegrid-event-end
                         (car (org-timegrid-org--cached-events "dummy.org" 0 1440)))))
        (org-timegrid-org--cached-events "dummy.org" 0 1440)
        (should (= calls 1))
        (setq minute 101)
        (should (= 101 (org-timegrid-event-end
                         (car (org-timegrid-org--cached-events "dummy.org" 0 1440)))))
        (should (= calls 2))))))

(ert-deftest org-timegrid-cache-day-hour-tiles-and-hotspots ()
  "A block crossing both boundaries damages four cells with local hotspots."
  (with-temp-buffer
    (let ((org-timegrid--tile-columns 3) (org-timegrid--tile-count 6)
          (org-timegrid--tile-width 300) (org-timegrid--tile-height 60)
          (org-timegrid--image-height 120)
          (hotspots '(((rect . ((155 . 55) . (165 . 65))) block (pointer hand)))))
      (cl-letf (((symbol-function 'org-timegrid--label-width) (lambda () 20))
                ((symbol-function 'org-timegrid--column-width) (lambda () 140)))
        (should (equal '(1 2 4 5)
                       (org-timegrid--geometry-tiles '(:x 155 :y 55 :width 10 :height 10))))
        (should (equal '(0 . 60) (org-timegrid--tile-bounds 2)))
        (should (equal '(60 . 60) (org-timegrid--tile-bounds 3)))
        (should (= 3 (org-timegrid--tile-at-pixel 65)))
        (should (equal '((rect . ((135 . 55) . (140 . 60))) block (pointer hand))
                       (car (org-timegrid--tile-image-map 1 hotspots))))
        (should (equal '((rect . ((0 . 0) . (5 . 5))) block (pointer hand))
                       (car (org-timegrid--tile-image-map 5 hotspots))))
        (setq org-timegrid--static-images (make-vector 6 '(image :type svg :data "dummy")))
        (org-timegrid--insert-tiles)
        (should (= 2 (line-number-at-pos (point-max))))
        (should (= (line-beginning-position) (aref org-timegrid--tile-markers 3)))
        (should (equal '(162 . 63)
                       (org-timegrid--position-image-xy
                        (list nil (aref org-timegrid--tile-markers 5)
                              nil nil nil nil nil nil '(2 . 3)))))))))

(ert-deftest org-timegrid-cache-rendered-views-track-data-and-display ()
  "Returning to a date reuses tiles; data, font scale and palette invalidate."
  (with-temp-buffer
    (let* ((day 739915)
           (event (org-timegrid-event-create :id 'one :title "One"
                                             :start (+ (* day 1440) 600)
                                             :end (+ (* day 1440) 660)))
           (org-timegrid--backend (org-timegrid-backend-create :name "Dummy"))
           (org-timegrid--state (org-timegrid--calendar-state-create
                                 :week-start day :events (list event)
                                 :blocks (org-timegrid-events-to-blocks (list event) day)))
           (build (symbol-function 'org-timegrid--build-static-tiles))
           (scale 1.0) (palette (org-timegrid--palette)) (calls 0))
      (cl-letf (((symbol-function 'org-timegrid--zoom-factor) (lambda (&rest _) scale))
                ((symbol-function 'org-timegrid--palette) (lambda () palette))
                ((symbol-function 'image-flush) #'ignore)
                ((symbol-function 'create-image) (lambda (data &rest _) (list 'image :type 'svg :data data)))
                ((symbol-function 'org-timegrid--build-static-tiles)
                 (lambda (&rest args) (cl-incf calls) (apply build args))))
        (org-timegrid--cache-static-tiles)
        (let ((images org-timegrid--static-images))
          (org-timegrid--cache-static-tiles)
          (should (eq images org-timegrid--static-images))
          (should (= calls 1))
          (org-timegrid--cache-static-tiles 'one)
          (should (= calls 1))
          (should-not (seq-find (lambda (g) (eq 'one (plist-get g :id))) org-timegrid--geometry))
          (should-not (string-match-p "One" (apply #'concat (append org-timegrid--static-fragments nil))))
          (should org-timegrid--excluded-tiles)
          (org-timegrid--cache-static-tiles)
          (should (eq images org-timegrid--static-images))
          (should-not org-timegrid--excluded-tiles)
          (should (seq-find (lambda (g) (eq 'one (plist-get g :id))) org-timegrid--geometry)))
        (setf (org-timegrid--calendar-state-week-start org-timegrid--state) (1+ day))
        (org-timegrid--cache-static-tiles)
        (setf (org-timegrid--calendar-state-week-start org-timegrid--state) day)
        (org-timegrid--cache-static-tiles)
        (should (= calls 2))
        (let ((events (list (org-timegrid-event-create
                             :id 'two :title "Two" :start (+ (* day 1440) 600)
                             :end (+ (* day 1440) 660)))))
          (setf (org-timegrid--calendar-state-events org-timegrid--state) events
                (org-timegrid--calendar-state-blocks org-timegrid--state)
                (org-timegrid-events-to-blocks events day)))
        (org-timegrid--cache-static-tiles)
        (should (= calls 3))
        (should (string-match-p "Two" (apply #'concat (append org-timegrid--static-fragments nil))))
        (should (= 2 (length org-timegrid--view-cache)))
        (setq scale 1.2)
        (org-timegrid--cache-static-tiles)
        (should (= calls 4))
        (should (= 1 (length org-timegrid--view-cache)))
        (setq palette (plist-put (copy-sequence palette) :background "#123456"))
        (org-timegrid--cache-static-tiles)
        (should (= calls 5))
        (setf (org-timegrid-event-title
               (car (org-timegrid--calendar-state-events org-timegrid--state))) "Three"
              (org-timegrid--calendar-state-blocks org-timegrid--state)
              (org-timegrid-events-to-blocks
               (org-timegrid--calendar-state-events org-timegrid--state) day))
        (org-timegrid--cache-static-tiles)
        (should (= calls 6))
        (should (string-match-p "Three" (apply #'concat (append org-timegrid--static-fragments nil))))
        (let ((state org-timegrid--state)
              (images org-timegrid--static-images)
              (geometry org-timegrid--geometry)
              (width (org-timegrid--canvas-width))
              (intersect (symbol-function 'org-timegrid--tiles-intersecting))
              ranges)
          (org-timegrid--cached-header)
          (setf (org-timegrid-backend-list-function org-timegrid--backend)
                (lambda (&rest _) (list event)))
          (cl-letf (((symbol-function 'org-timegrid--schedule-prewarm) #'ignore)
                    ((symbol-function 'input-pending-p) (lambda (&rest _) nil))
                    ((symbol-function 'get-buffer-window) (lambda (&rest _) (selected-window)))
                    ((symbol-function 'org-timegrid--canvas-width) (lambda () width))
                    ((symbol-function 'org-timegrid--window-scroll-pixels) (lambda (&rest _) 600))
                    ((symbol-function 'org-timegrid--tiles-intersecting)
                     (lambda (&rest args) (push args ranges) (apply intersect args))))
            (org-timegrid--prewarm-next))
          ;; Date navigation opens at the top even when this view is scrolled.
          (should (= 0 (caar ranges)))
          (should (= (window-body-height (selected-window) t) (cadar ranges)))
          (should (eq state org-timegrid--state))
          (should (eq images org-timegrid--static-images))
          (should (eq geometry org-timegrid--geometry))
          (should (= 2 (length org-timegrid--view-cache))))))))

(ert-deftest org-timegrid-cache-resize-damages-edges-and-labels ()
  "A small extension of a long block leaves its unchanged middle alone."
  (with-temp-buffer
    (let* ((org-timegrid--tile-count 24) (org-timegrid--tile-columns 1)
           (org-timegrid--tile-height 60) (org-timegrid--tile-width 900)
           (org-timegrid--image-height 1440)
           (old '(:id event :x 100 :y 120 :width 100 :height 480 :title "Task"))
           (new (plist-put (copy-sequence old) :height 495)))
      (cl-letf (((symbol-function 'org-timegrid--scale-pixels) #'identity)
                ((symbol-function 'org-timegrid--font-size) #'identity))
        (let ((dirty (delete-dups (mapcan #'org-timegrid--geometry-tiles (org-timegrid--block-damage (list old) (list new))))))
          (should (memq 2 dirty))
          (should (memq 10 dirty))
          (should-not (memq 5 dirty)))
        (should-not (org-timegrid--block-damage
                     (list old) (list (plist-put (copy-sequence new) :width 90))))))))

(ert-deftest org-timegrid-cache-prunes-outside-navigation-horizon ()
  (with-temp-buffer
    (let* ((day 739915)
           (org-timegrid--state (org-timegrid--calendar-state-create :week-start day))
           (org-timegrid--view-cache
            (mapcar (lambda (offset)
                      (org-timegrid--cached-view-create :key (list nil (+ day offset) nil)))
                    '(-15 -14 0 7 8))))
      (cl-letf (((symbol-function 'run-with-idle-timer) #'ignore))
        (org-timegrid--schedule-prewarm))
      (should (equal (list (- day 14) day (+ day 7))
                     (mapcar (lambda (view) (nth 1 (org-timegrid--cached-view-key view)))
                             org-timegrid--view-cache))))))

(ert-deftest org-timegrid-cache-preview-images-stay-bounded ()
  "Long drag sessions keep recent images and release older ones."
  (with-temp-buffer
    (let ((flushed 0))
      (cl-letf (((symbol-function 'image-flush) (lambda (&rest _) (cl-incf flushed))))
        (dotimes (index 100)
          (org-timegrid--retire-image (list 'image :data (format "frame-%s" index))))
        (should (= 32 (length org-timegrid--transient-images)))
        (should (= 68 flushed))
        (let ((replacement (copy-tree (car org-timegrid--transient-images))))
          (org-timegrid--retire-image nil replacement)
          (should-not (member replacement org-timegrid--transient-images))
          (should (= 68 flushed)))))))

(ert-deftest org-timegrid-cache-preview-lanes-stay-steady ()
  "A preview preserves its lane, then returns to normal layout on commit."
  (with-temp-buffer
    (let* ((org-timegrid--static-render nil)
           (org-timegrid--geometry
            '((:id event :day 0 :x 100 :width 70)))
           (block (org-timegrid--make-block 'event 0 600 660 "Task")))
      (setf (org-timegrid-block-preview block) t)
      (should (equal '(100 . 71) (org-timegrid--layout-frame block 0 300)))
      (setq org-timegrid--scene (org-timegrid--scene-create :geometry '((:id event :day 0 :x 120 :width 60))))
      (should (equal '(120 . 61) (org-timegrid--layout-frame block 0 300)))
      (let ((org-timegrid--static-render t))
        (should (equal '(0 . 300) (org-timegrid--layout-frame block 0 300)))))))

(ert-deftest org-timegrid-cache-prepared-preview-images ()
  "Reuse prepared images, bound memory, and invalidate changed backgrounds."
  (with-temp-buffer
    (let* ((block (org-timegrid--make-block 'one 0 600 645 "Task"))
           (org-timegrid--state (org-timegrid--calendar-state-create
                                 :preview (org-timegrid--edit-proposal block 15 0 nil)))
           (org-timegrid-preview-prefetch t)
           (org-timegrid--static-images (vector nil))
           (created 0) flushed)
      (cl-letf (((symbol-function 'org-timegrid--create-tile-image)
                 (lambda (tile fragment &rest _)
                   (cl-incf created) (list 'image :data (format "%s:%s" tile fragment))))
                ((symbol-function 'image-flush) (lambda (image &rest _) (push image flushed))))
        (let ((image (org-timegrid--make-tile-image 0 "first")))
          (should (eq image (org-timegrid--make-tile-image 0 "first")))
          (should (= created 1))
          (org-timegrid--retire-image image)
          (should-not org-timegrid--transient-images))
        (dotimes (i 140) (org-timegrid--make-tile-image 0 (number-to-string i)))
        (should (= org-timegrid--preview-cache-limit (hash-table-count org-timegrid--preview-cache)))
        (should (= org-timegrid--preview-cache-limit (hash-table-count org-timegrid--preview-images)))
        (should flushed)
        (let ((previous org-timegrid--preview-cache))
          (setq org-timegrid--static-images (vector nil))
          (org-timegrid--make-tile-image 0 "new background")
          (should-not (eq previous org-timegrid--preview-cache))
          (should (= 1 (hash-table-count org-timegrid--preview-cache))))
        (let ((previous org-timegrid--preview-cache))
          (setq org-timegrid--clock-fragment "new time")
          (org-timegrid--make-tile-image 0 "new clock")
          (should-not (eq previous org-timegrid--preview-cache)))
        (org-timegrid--clear-view-cache)
        (should-not org-timegrid--preview-cache)))))

(ert-deftest org-timegrid-cache-preview-preparation-preserves-canvas ()
  "Prepare geometry or one image per step without changing the active preview."
  (with-temp-buffer
    (let* ((day 739915)
           (event (org-timegrid-event-create :id 'one :title "Task"
                                             :start (+ (* day 1440) 600) :end (+ (* day 1440) 645)))
           (blocks (org-timegrid-events-to-blocks (list event) day))
           (org-timegrid--backend (org-timegrid-backend-create :name "Dummy"))
           (org-timegrid--state (org-timegrid--calendar-state-create
                                 :week-start day :events (list event) :blocks blocks))
           (org-timegrid-preview-prefetch t) (decodes 0))
      (cl-letf (((symbol-function 'create-image) (lambda (data &rest _) (list 'image :data data)))
                ((symbol-function 'image-flush) #'ignore)
                ((symbol-function 'image-size) (lambda (&rest _) (cl-incf decodes) '(90 . 60)))
                ((symbol-function 'run-at-time) #'ignore)
                ((symbol-function 'window-body-height) (lambda (&rest _) 2000))
                ((symbol-function 'org-timegrid--canvas-width) (lambda () 900))
                ((symbol-function 'get-buffer-window) (lambda (&rest _) (selected-window)))
                ((symbol-function 'org-timegrid--window-scroll-pixels) (lambda (&rest _) 0)))
        (setf (org-timegrid--calendar-state-preview org-timegrid--state)
              (org-timegrid--edit-proposal (car blocks) 15 0 'bottom))
        (org-timegrid--cache-static-tiles 'one)
        (setq org-timegrid--scene (org-timegrid--build-scene))
        (org-timegrid--schedule-preview-preparation nil)
        (let ((proposal (car org-timegrid--preview-candidates))
              (state org-timegrid--state) (geometry org-timegrid--scene)
              (images org-timegrid--static-images) (tick (buffer-modified-tick)))
          (org-timegrid--prepare-preview-next)
          (should (= 0 decodes))
          (should org-timegrid--preview-jobs)
          (let ((jobs org-timegrid--preview-jobs))
            (org-timegrid--prepare-preview-next)
            (should (= 1 decodes))
            ;; Revisiting a candidate must skip its already decoded image.
            (setq org-timegrid--preview-jobs nil
                  org-timegrid--preview-candidates (list proposal))
            (org-timegrid--prepare-preview-next)
            (should (= 1 decodes))
            (should (equal org-timegrid--preview-jobs (cdr jobs))))
          (should (eq state org-timegrid--state))
          (should (eq geometry org-timegrid--scene))
          (should (eq images org-timegrid--static-images))
          (should (= tick (buffer-modified-tick))))
        (org-timegrid--clear-preview-cache)))))

(ert-deftest org-timegrid-cache-preview-input-and-cancellation ()
  "Defer work for input, preserve repeated targets, and cancel on release."
  (with-temp-buffer
    (let* ((block (org-timegrid--make-block 'one 0 600 645 "Task"))
           (org-timegrid--state (org-timegrid--calendar-state-create :blocks (list block)))
           (org-timegrid-preview-prefetch t) callback (pending t) (steps 0))
      (cl-letf (((symbol-function 'run-at-time)
                 (lambda (_delay _repeat fn &rest _) (setq callback fn) (timer-create)))
                ((symbol-function 'get-buffer-window) (lambda (&rest _) (selected-window)))
                ((symbol-function 'input-pending-p) (lambda (&rest _) pending))
                ((symbol-function 'org-timegrid--render-dynamic) #'ignore)
                ((symbol-function 'org-timegrid--refresh) #'ignore)
                ((symbol-function 'org-timegrid--prepare-preview-next) (lambda () (cl-incf steps))))
        (let ((proposal (org-timegrid--edit-proposal block 15 0 nil)))
          (org-timegrid--set-preview proposal)
          (let ((timer org-timegrid--preview-timer) (jobs org-timegrid--preview-candidates))
            (org-timegrid--set-preview proposal)
            (should (eq timer org-timegrid--preview-timer))
            (should (eq jobs org-timegrid--preview-candidates))))
        (funcall callback)
        (should (= steps 0))
        (setq pending nil)
        (funcall callback)
        (should (= steps 1))
        (org-timegrid--clear-preview)
        (should-not org-timegrid--preview-timer)
        (should-not org-timegrid--preview-cache)
        (should-not org-timegrid--preview-candidates)
        (org-timegrid--set-preview (org-timegrid--edit-proposal block -15 0 'top))
        (let* ((next (car org-timegrid--preview-candidates))
               (target (org-timegrid--operation-block next)))
          (should (= 570 (org-timegrid-block-start target))))
        (let ((org-timegrid-preview-prefetch nil))
          (funcall callback)
          (should-not org-timegrid--preview-cache)
          (should-not org-timegrid--preview-timer))
        (org-timegrid--set-preview (org-timegrid--edit-proposal block -30 0 'top))
        (org-timegrid--cancel-timers)
        (should-not org-timegrid--preview-timer)
        (should-not org-timegrid--preview-cache)))))

(ert-deftest org-timegrid-cache-scene-is-independent-of-svg ()
  "A candidate scene resolves bounds without painting or changing active state."
  (with-temp-buffer
    (let* ((block (org-timegrid--make-block 'one 0 600 645 "Task"))
           (org-timegrid--state (org-timegrid--calendar-state-create :blocks (list block)))
           (org-timegrid--image-height 1440)
           (proposal (org-timegrid--edit-proposal block 15 0 nil))
           (state org-timegrid--state) (tick (buffer-modified-tick)))
      (cl-letf (((symbol-function 'svg-create) (lambda (&rest _) (ert-fail "Scene used SVG"))))
        (let* ((scene (org-timegrid--build-scene proposal))
               (bounds (car (org-timegrid--scene-geometry scene))))
          (should (eq (caar (org-timegrid--scene-nodes scene)) 'block))
          (should (= (plist-get bounds :start) 615))
          (should (> (plist-get bounds :height) 0))
          (should (eq state org-timegrid--state))
          (should-not (org-timegrid--calendar-state-preview state))
          (should-not org-timegrid--scene)
          (should (= tick (buffer-modified-tick))))))))

(ert-deftest org-timegrid-cache-scene-region-damage ()
  "Scene comparison preserves unchanged region interiors and clears removed nodes."
  (let* ((region '(region :x 100 :y 120 :width 100 :height 480))
         (cursor '(cursor :x 100 :y 600 :width 100 :height 15))
         (old (org-timegrid--scene-create :nodes (list region cursor)))
         (new (org-timegrid--scene-create
               :nodes '((region :x 100 :y 120 :width 100 :height 495)
                        (cursor :x 100 :y 615 :width 100 :height 15)))))
    (should-not (org-timegrid--scene-damage old old))
    (let ((damage (org-timegrid--scene-damage old new)))
      (cl-labels ((covers (y)
                    (seq-some (lambda (rect)
                                (<= (plist-get rect :y) y
                                    (+ (plist-get rect :y) (plist-get rect :height)))) damage)))
        (should (covers 120))
        (should (covers 600))
        (should (covers 630))
        (should-not (covers 350))))
    (should (org-timegrid--scene-damage old (org-timegrid--scene-create)))))

(ert-deftest org-timegrid-cache-clock-clears-removed-region ()
  "A clock redraw combined with clearing a region leaves no grey tiles."
  (with-temp-buffer
    (let ((org-timegrid-days 7)
          (org-timegrid--state
           (org-timegrid--calendar-state-create
            :week-start 100 :cursor-visible t :region-active t
            :mark (+ (* 100 1440) 600)
            :cursor (org-timegrid--cursor-state-create :surface 'grid :day 0 :minute 735))))
      (cl-letf (((symbol-function 'create-image)
                 (lambda (data &rest properties)
                   (append (list 'image :type 'svg :data data) properties)))
                ((symbol-function 'svg-image)
                 (lambda (svg &rest properties)
                   (append (list 'image :type 'svg :data
                                 (with-temp-buffer (svg-print svg) (buffer-string))) properties)))
                ((symbol-function 'image-flush) #'ignore)
                ((symbol-function 'redisplay) #'ignore)
                ((symbol-function 'org-timegrid--schedule-prewarm) #'ignore))
        (org-timegrid--refresh)
        (should (> (length org-timegrid--dynamic-tiles) 1))
        (org-timegrid--with-update nil
          (org-timegrid--deactivate-region)
          (org-timegrid--with-update 'clock))
        (should-not (org-timegrid-region-active-p))
        (should (equal '(cursor) (mapcar #'car (org-timegrid--scene-nodes org-timegrid--scene))))
        (dotimes (tile org-timegrid--tile-count)
          (unless (memq tile org-timegrid--dynamic-tiles)
            (should (eq (get-text-property (aref org-timegrid--tile-markers tile) 'display)
                        (aref org-timegrid--static-images tile)))))))))

(ert-deftest org-timegrid-cache-clock-invalidates-scene ()
  "A changed background clock repaints images even if their overlay is unchanged."
  (with-temp-buffer
    (let ((org-timegrid--state (org-timegrid--calendar-state-create))
          (org-timegrid--scene (org-timegrid--scene-create))
          (org-timegrid--static-inner "background")
          (org-timegrid--static-images (vector nil))
          (org-timegrid--clock-tiles '(0))
          (org-timegrid--dynamic-tiles '(0)) (painted nil))
      (cl-letf (((symbol-function 'derived-mode-p) (lambda (&rest _) t))
                ((symbol-function 'get-buffer-window) (lambda (&rest _) (selected-window)))
                ((symbol-function 'org-timegrid--update-clock-fragment) #'ignore)
                ((symbol-function 'org-timegrid--render-header-dynamic) #'ignore)
                ((symbol-function 'org-timegrid--make-tile-image) (lambda (&rest _) '(image)))
                ((symbol-function 'org-timegrid--render-dynamic)
                 (lambda (&rest _) (should-not org-timegrid--scene) (setq painted t)))
                ((symbol-function 'redisplay) #'ignore))
        (org-timegrid--clock-tick (current-buffer))
        (should painted)))))

